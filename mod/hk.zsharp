namespace Hk;

import Workspace.Util;

##
 * Hk — parser i zapis formatu .hk (ta sama gramatyka co hk-parser z bit.io):
 *   ! komentarz (tylko cała linia)        [sekcja]
 *   -> klucz => wartość                   --> podklucz => wartość      ---> trzeci poziom
 *   -> klucz                              (bez `=>`: otwiera mapę, wpisy `-->` należą do niej)
 *   [a, b]  — tablica;  true/false — bool;  reszta — tekst (cudzysłowy są zdejmowane)
 * Wynik parse: [sekcja => [klucz => wartość|lista|mapa]] z zachowaniem kolejności.
##

func fail($line, $msg) { throw new Exception("nula.hk:" . $line . ": " . $msg); }

func unquote($v) {
    $v = trim($v);
    $n = strlen($v);
    if ($n >= 2) {
        $a = substr($v, 0, 1);
        $b = substr($v, $n - 1, 1);
        if (($a === "\"" || $a === "'") && $a === $b) { return substr($v, 1, $n - 2); }
    }
    return $v;
}

func parseValue($raw) {
    $v = trim($raw);
    if (starts_with($v, "[") && ends_with($v, "]")) {
        $inner = trim(substr($v, 1, strlen($v) - 2));
        $out = [];
        if ($inner === "") { return $out; }
        foreach (split($inner, ",") as $p) { $out[] = unquote($p); }
        return $out;
    }
    if ($v === "true") { return true; }
    if ($v === "false") { return false; }
    return unquote($v);
}

func parse($text) {
    $doc = [];
    $sec = "";
    $k1 = "";
    $k2 = "";
    $lines = Util.lines($text);
    for ($i = 0; $i < count($lines); $i++) {
        $l = trim($lines[$i]);
        $no = $i + 1;
        if ($l === "" || starts_with($l, "!")) { continue; }
        if (starts_with($l, "[")) {
            if (!ends_with($l, "]")) { fail($no, "niedomknięty nagłówek sekcji"); }
            $sec = trim(substr($l, 1, strlen($l) - 2));
            if ($sec === "") { fail($no, "pusta nazwa sekcji"); }
            if (!has_key($doc, $sec)) { $doc[$sec] = []; }
            $k1 = "";
            $k2 = "";
            continue;
        }
        if (!starts_with($l, "-")) { fail($no, "oczekiwano `-> klucz => wartość` albo [sekcja]"); }
        if ($sec === "") { fail($no, "wpis poza sekcją"); }
        $d = 0;
        while ($d < strlen($l) && substr($l, $d, 1) === "-") { $d++; }
        if (substr($l, $d, 1) !== ">") { fail($no, "po myślnikach musi stać `>` (np. `-> klucz => wartość`)"); }
        $rest = trim(substr($l, $d + 1));
        $arrow = index_of($rest, "=>");
        $key = $rest;
        $val = [];
        if ($arrow >= 0) {
            $key = trim(substr($rest, 0, $arrow));
            $val = parseValue(substr($rest, $arrow + 2));
        }
        if ($key === "") { fail($no, "pusty klucz"); }
        if ($d === 1) {
            $doc[$sec][$key] = $val;
            $k1 = $key;
            $k2 = "";
        } else if ($d === 2) {
            if ($k1 === "") { fail($no, "`-->` bez wpisu nadrzędnego `->`"); }
            if (!is_array($doc[$sec][$k1])) { fail($no, "klucz `" . $k1 . "` ma wartość — nie może być jednocześnie mapą"); }
            $doc[$sec][$k1][$key] = $val;
            $k2 = $key;
        } else if ($d === 3) {
            if ($k2 === "") { fail($no, "`--->` bez wpisu nadrzędnego `-->`"); }
            if (!is_array($doc[$sec][$k1][$k2])) { fail($no, "klucz `" . $k2 . "` ma wartość — nie może być jednocześnie mapą"); }
            $doc[$sec][$k1][$k2][$key] = $val;
        } else {
            fail($no, "zbyt głębokie zagnieżdżenie (maks. `--->`)");
        }
    }
    return $doc;
}

func section($doc, $sec) { return has_key($doc, $sec) ? $doc[$sec] : []; }

func get($doc, $sec, $key, $default = null) {
    if (has_key($doc, $sec) && has_key($doc[$sec], $key)) { return $doc[$sec][$key]; }
    return $default;
}

# wartość jako lista (pojedynczy tekst → lista jednoelementowa; pusty → [])
func asList($v) {
    if ($v === null || $v === "") { return []; }
    if (is_array($v)) { return $v; }
    return [$v];
}

func isList($a) {
    $i = 0;
    foreach ($a as $k => $v) {
        if ($k !== $i) { return false; }
        $i++;
    }
    return true;
}

func scalarText($v) {
    if ($v === true) { return "true"; }
    if ($v === false) { return "false"; }
    return strval($v);
}

func valueText($v) {
    if (is_array($v)) {
        $p = [];
        foreach ($v as $x) { $p[] = scalarText($x); }
        return "[" . join($p, ", ") . "]";
    }
    return scalarText($v);
}

# dokument → tekst .hk (do dwóch poziomów zagnieżdżenia)
func encode($doc) {
    $out = [];
    foreach ($doc as $sec => $entries) {
        if (count($out) > 0) { $out[] = ""; }
        $out[] = "[" . $sec . "]";
        foreach ($entries as $k => $v) {
            if (is_array($v) && count($v) > 0 && !isList($v)) {
                $out[] = "-> " . $k;
                foreach ($v as $k2 => $v2) { $out[] = "--> " . $k2 . " => " . valueText($v2); }
            } else {
                $out[] = "-> " . $k . " => " . valueText($v);
            }
        }
    }
    return join($out, "\n") . "\n";
}
